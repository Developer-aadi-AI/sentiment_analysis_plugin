# Copy to .env on the server (next to docker-compose.yml) and fill in the blanks.
# Never commit the real file.

# ---- LLM: Groq free tier ($0, rate-limited) ----
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# Your Groq key (console.groq.com/keys)
LLM_API_KEY=

# ---- Source: CSV demo (switch to webhook/sql later) ----
ADAPTER=csv
SOURCE_FILE=examples/feedback.csv
SOURCE_NAME=demo-shop
SOURCE_FIELD_MAP={"id":"feedback_id","text":"comment","rating":"stars","customer_name":"name","customer_email":"email","created_at":"submitted_at"}
POLL_INTERVAL_SECONDS=300

# ---- Email (not used while DRY_RUN=true) ----
SINK=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=

# ---- Brand ----
BRAND_NAME=Demo Shop
BRAND_SIGNOFF=The Demo Shop Team
BRAND_VOICE=Warm, concise, human. No corporate jargon.
BRAND_NEVER_PROMISE=refunds, discounts, compensation, delivery dates

# ---- Safety ----
DRY_RUN=true
AUTO_SEND=false
MIN_CONFIDENCE=0.7
# Required: protects /run, /pending, /approve, /replay. Generate with:  openssl rand -hex 32
ADMIN_TOKEN=
