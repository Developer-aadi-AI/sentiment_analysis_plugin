# ---- LLM (any LangChain-supported provider) ----
# anthropic | openai | groq | google_genai | ollama | offline (rule-based, no network; for local demos)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
# auto | json_schema | function_calling  (auto picks json_schema for anthropic/openai)
LLM_STRUCTURED_METHOD=auto

# ---- Source adapter: csv | json | webhook | sql ----
ADAPTER=csv
SOURCE_FILE=examples/feedback.csv
# Map host-app column names -> internal Review fields (JSON). Omit fields that already match.
SOURCE_FIELD_MAP={"id":"feedback_id","text":"comment","rating":"stars","customer_name":"name","customer_email":"email","created_at":"submitted_at"}
SOURCE_NAME=demo-shop

# sql adapter
SOURCE_DB_URL=
SOURCE_TABLE=feedback
SOURCE_PROCESSED_COLUMN=
SOURCE_CONTEXT_QUERY=

# webhook adapter
WEBHOOK_SECRET=
# Bearer token for /run, /pending, /approve, /replay (unset = localhost only)
ADMIN_TOKEN=

# ---- Sink: smtp | console ----
SINK=smtp
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=support@example.com

# ---- Brand voice ----
BRAND_NAME=Demo Shop
BRAND_SIGNOFF=The Demo Shop Team
BRAND_VOICE=Warm, concise, human. No corporate jargon.
BRAND_NEVER_PROMISE=refunds, discounts, compensation, delivery dates

# ---- Safety ----
DRY_RUN=true
AUTO_SEND=false
MIN_CONFIDENCE=0.7
STATE_DB=.review_responder/state.db
